# Keep LF in the repo and in checkouts (core.autocrlf=true on Windows would otherwise turn
# infra files such as infra/kafka/topics.txt into CRLF, putting \r into topic names).
* text=auto eol=lf
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
mvnw.cmd text eol=crlf
*.ps1 text eol=crlf
*.jar binary
